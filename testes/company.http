
# =============================================
# VARIÁVEIS GLOBAIS — altere aqui suas credenciais
# =============================================
@baseUrl    = https://projeto-integrador-fiado.onrender.com
@companyUrl = {{baseUrl}}/company

@email      = admin@admin

@senha      = admin


# =============================================
# PASSO 1: Login — execute esta requisição primeiro
# O token será capturado automaticamente nas rotas abaixo
# =============================================

# @name login
POST {{baseUrl}}/user/login HTTP/1.1
content-type: application/json

{
  "email": "{{email}}",
  "senha": "{{senha}}"
}

###

@token = {{login.response.body.$.token}}


# =============================================
# ROTAS PROTEGIDAS (precisam de token)
# =============================================

### Criar company (Apenas userOwner)
POST {{baseUrl}}/company HTTP/1.1
content-type: application/json
Authorization: Bearer {{token}}

{
  "name":     "abrobrinha",
  "category": "balas",
  "cnpj":     "12452091",
  "places":   "adacy",
  "zip_code": "1356899",
  "addrres":  "rua 2",
  "phone":    "190"
}


### Atualizar company (admin ou userOwner — só a própria)
PUT {{baseUrl}}/company/23 HTTP/1.1
content-type: application/json
Authorization: Bearer {{token}}

{
  "name":     "teste",
  "category": "Alimentação",
  "cnpj":     "12345678000199",
  "places":   "Localização da empresa",
  "zip_code": "12345-678",
  "addrres":  "Rua Exemplo, 123",
  "phone":    "(11) 1234-5678"
}


### Deletar company (admin ou userOwner — só a própria)
DELETE {{baseUrl}}/company/20 HTTP/1.1
content-type: application/json
Authorization: Bearer {{token}}


# =============================================
# ROTAS DE LEITURA (token opcional)
# =============================================

### Listar todas as companies
GET {{baseUrl}}/company HTTP/1.1
content-type: application/json
Authorization: Bearer {{token}}


### Buscar uma company por ID
GET {{baseUrl}}/company/2 HTTP/1.1
content-type: application/json
Authorization: Bearer {{token}}


### Buscar por nome
GET {{baseUrl}}/company?name=teste HTTP/1.1
content-type: application/json

