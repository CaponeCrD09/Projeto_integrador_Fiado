@emailLogin = teste@teste
@senhaLogin = 123

@baseUrl = https://projeto-integrador-fiado.onrender.com

//@baseUrl = http://localhost:3000


### Fazer o login
# @name realizarLogin
POST {{baseUrl}}/user/login HTTP/1.1
content-type: application/json

{
  "email": "{{emailLogin}}",
  "senha": "{{senhaLogin}}"
}

### Salva o Token Globalmente
@authToken = {{realizarLogin.response.body.token}}


# =============================================
# ROTAS PROTEGIDAS (precisam de token)
# =============================================

### Criar company (Apenas userOwner)
POST {{baseUrl}}/company HTTP/1.1
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "name":     "teste3",
  "category": "balas",
  "cnpj":     "12f43342",
  "places":   "adacy",
  "zip_code": "1356899",
  "addrres":  "rua 2",
  "phone":    "190"
}


### Atualizar company (admin ou userOwner — só a própria)
PUT {{baseUrl}}/company/34 HTTP/1.1
content-type: application/json
Authorization: Bearer {{authToken}}

{
  "name":     "teste",
  "category": "Alimentação",
  "cnpj":     "12345678000199",
  "places":   "Localização da empresa",
  "zip_code": "12345-678",
  "addrres":  "Rua Exemplo, 123",
  "phone":    "(11) 1234-5678"
}


### Deletar company (admin ou userOwner — só a própria)
DELETE {{baseUrl}}/company/20 HTTP/1.1
content-type: application/json
Authorization: Bearer {{authToken}}


# =============================================
# ROTAS DE LEITURA (token opcional)
# =============================================

### Listar todas as companies
GET {{baseUrl}}/company HTTP/1.1
content-type: application/json
Authorization: Bearer {{authToken}}


### Buscar uma company por ID
GET {{baseUrl}}/company/26 HTTP/1.1
content-type: application/json
Authorization: Bearer {{authToken}}


### Buscar por nome
GET {{baseUrl}}/company?name=teste HTTP/1.1
content-type: application/json

